DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promise_tracker
NEWS_API_KEY=your_newsapi_key_here
ENVIRONMENT=development

# LLM Provider: "ollama" (local/free) or "anthropic" (production)
LLM_PROVIDER=ollama

# Ollama (default — run: ollama pull llama3.1)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Anthropic — uncomment and set LLM_PROVIDER=anthropic to upgrade
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6
